# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ── Google Auth ───────────────────────────────────────────────────────────────
# Railway / Production: paste the ENTIRE service-account.json content as one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Local dev only (leave empty on Railway):
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Spreadsheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Comma-separated Telegram user IDs with admin role
ADMIN_IDS=123456789,987654321

# Sheet tab names (defaults shown, usually no need to change)
SHEET_CHECKS=Cheklar
SHEET_USERS=Users

# Logging level: error | warn | info | debug
LOG_LEVEL=info
