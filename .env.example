# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ── Google Auth — Railway uchun ALOHIDA MAYDONLAR (eng ishonchli) ─────────────
# service-account.json faylidan quyidagi maydonlarni ko'chiring:

GOOGLE_CLIENT_EMAIL=click-check-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PRIVATE_KEY_ID=abc123
GOOGLE_CLIENT_ID=123456789

# ── Local dev uchun (Railway da shart emas) ───────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# ── Google Sheets ─────────────────────────────────────────────────────────────
SPREADSHEET_ID=your_spreadsheet_id_here

# Admin Telegram user ID lari (vergul bilan)
ADMIN_IDS=123456789,987654321

# Sheet tab nomlari
SHEET_CHECKS=Cheklar
SHEET_USERS=Users

# Log darajasi: error | warn | info | debug
LOG_LEVEL=info
