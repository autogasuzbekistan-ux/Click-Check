# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Google Cloud Vision API - service account JSON path
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Google Sheets Spreadsheet ID (from the sheet URL)
SPREADSHEET_ID=your_spreadsheet_id_here

# Comma-separated Telegram user IDs with admin role
ADMIN_IDS=123456789,987654321

# Sheet tab names (defaults shown)
SHEET_CHECKS=Cheklar
SHEET_USERS=Users

# Optional: Logging level (error, warn, info, debug)
LOG_LEVEL=info
